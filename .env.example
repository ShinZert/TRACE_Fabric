OPENAI_API_KEY=sk-proj-your-key-here
SECRET_KEY=generate-a-random-secret-here

# Deploy script settings — required for ./deploy.sh and ./deploy-dev.sh
# Kept out of the repo so the public source doesn't publish the IP.
DROPLET_IP=YOUR_DROPLET_IP

# Optional — only needed for ./deploy.sh set-token / login
GITHUB_USER=your-github-username
GITHUB_TOKEN=ghp_your-personal-access-token
